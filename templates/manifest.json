{
  "name": {{ (t('app.name') ~ ' · ' ~ t('app.tagline'))|tojson }},
  "short_name": {{ t('app.name')|tojson }},
  "description": {{ t('app.tagline')|tojson }},
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f6fa",
  "theme_color": "#1a73e8",
  "icons": [
    {
      "src": "/static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
